  npx pm health,project,pi-glm,"2026-10-04T10:27:56.397Z",local_mutation,chore/pm-github-pm-cli-2026-10-4
  npx -y @unbrained/pm-cli@2026.10.4 github import unbraind/pm-cli,project,pi-glm,"2026-10-04T10:27:57.374Z",local_mutation,chore/pm-github-pm-cli-2026-10-4

  test/closeout.test.ts,project
tests[1]{command,scope,provenance{author,created_at,source_kind,source_ref}}:
  node --test test/closeout.test.ts,project,claude-orchestrator,"2026-10-30T19:11:10.551Z",local_mutation,fix/closeout-required-checks-from-branch-summary

    scope: project
    timeout_seconds: 300
    note: full release gate for pull request 57
  - command: ./node_modules/.bin/pm health --strict-exit
    scope: project
    timeout_seconds: 120
    provenance:
      author: pi-agent
      created_at: "2026-08-28T21:09:11.007Z"
      source_kind: local_mutation
      source_ref: dependabot/npm_and_yarn/unbrained/pm-cli-2026.8.25
    note: retargeted pm CLI exact pin health verification
docs[2]{path,scope,note}:

  NPM_CONFIG_USERCONFIG=/dev/null node --test --test-concurrency=1 test/import-projection.test.ts,project,codex-astra,"2026-11-06T12:49:05.501Z",local_mutation,coverage-memory-bound-and-fixture-cleanup

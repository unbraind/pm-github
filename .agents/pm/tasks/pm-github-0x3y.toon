  node --test test/closeout-workflow.test.ts,project,1200,codex-agent,"2026-10-16T00:52:51.590Z",local_mutation,feat/reusable-closeout-workflow
  node --test --test-name-pattern=permission-limited test/closeout-workflow.test.ts,project,1200,codex-agent,"2026-10-16T01:13:36.961Z",local_mutation,feat/reusable-closeout-workflow
  env HOME=$(mktemp -d) GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 node --test --test-name-pattern=closeout.contract test/closeout-workflow.test.ts,project,1200,codex-agent,"2026-10-16T02:19:38.716Z",local_mutation,feat/reusable-closeout-workflow

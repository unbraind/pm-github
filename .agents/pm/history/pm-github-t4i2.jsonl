{"hash_algorithm":"sha256","ts":"2026-10-14T21:42:54.457Z","author":"codex-agent","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"8883d09363214115c628d33e","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"xhigh","source":"probe"},"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-github-t4i2"},{"op":"add","path":"/metadata/title","value":"Close pm items delivered by merged pull requests with verifiable GitHub evidence"},{"op":"add","path":"/metadata/description","value":"Add a safe, idempotent pm github closeout command so agents can close delivered tracker items using facts verified against merged pull requests and head checks."},{"op":"add","path":"/metadata/type","value":"Feature"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":["changelog-unreleased"]},{"op":"add","path":"/metadata/created_at","value":"2026-10-14T21:42:54.457Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-14T21:42:54.457Z"},{"op":"add","path":"/metadata/author","value":"codex-agent"},{"op":"add","path":"/metadata/acceptance_criteria","value":"Resolve the existing repository and select repeatable --pr numbers or merged PRs at or after --since ISO time; dry-run by default, --apply writes, compact TOON and stable --json plan rows item/pr/action/reason.; Extract only same-repository .agents/pm/<folder>/<id>.toon links; report foreign-repository links and unknown ids as explicit skips; never import PR body or comment text.; Skip closed/canceled items and repeatable --skip ids; require merged PR and successful required head checks; missing/failed check evidence fails closed; unreadable protection falls back to all head runs completed with success/neutral/skipped and reports the applied rule.; Use the SDK close path with only PR number/URL, merge commit SHA, head SHA, merge time and passed head check names in the close reason; repeated selection performs zero additional tracker writes.; Test with existing GitHub HTTP fixtures and real temporary trackers: repository matching, unknown/terminal/skipped ids, failed required checks, missing evidence, fallback, dry-run byte equality, exact apply reason, repeated no-op and synthetic email/token privacy; demonstrate behavioral revert failures for check gating and idempotency.; Document agent examples and pm-changelog entry; optionally add a separate bot-branch closeout workflow only after complete tests, otherwise create a follow-up item; keep gated sync workflow and inputs unchanged.; Pass npm and Bun release:check with isolated Git identity and unchanged thresholds; regenerate and check changelog; commit tracker/history with code, push branch and open the requested public-safe PR without closing this item."}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"d45bd8cdd15ce4f56394c071e1e3717d303c8c42a8f1d0f0c4d09c3bd538a946","item_hash_version":3,"message":"","context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"d160abbc4f1bcd7534ae446bcb881bf53503797f67487839d3b9ec7973fe3e94"}

{"hash_algorithm":"sha256","ts":"2026-10-18T18:27:43.386Z","author":"codex-agent","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"e4446d2a1278b42fdf0b9f7f","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":null,"topic":null},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/1","value":{"created_at":"2026-10-18T18:27:43.386Z","author":"codex-agent","text":"Implemented explicit delivery declarations (closing canonical links, whole-line closing item ids or pm-github trailers, and exact PR URL metadata). The full selection is resolved before SDK writes; competing merged delivery claims receive ambiguous_delivery. Added minimal public title/body/commit fixtures from real pm-ado PRs 16 and 19. The real bodies contain only mentions; both are now refused until delivery is explicitly linked. Updated previous positive fixtures to declare delivery instead of relying on status."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-10-18T18:27:43.386Z"}],"before_hash":"3a3e03516eb2df9143029f7f3444de7b12bb24a2bebf614cda6a511f4f3f7aee","after_hash":"1a2b05376ad4f87e0b7e29378cadb0e9d4a1f13f7474d668f1ec6141d2b3d0c9","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"02dea5e365cf5f219f1c094268a04228fb8acd16cb4f175adb84fe5fcf9b028c"}

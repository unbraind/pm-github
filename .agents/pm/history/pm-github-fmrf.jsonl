{"hash_algorithm":"sha256","ts":"2026-10-12T10:46:45.720Z","author":"pi-gh-blockers","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"83097eb018453e49a23eaf19","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-github-fmrf"},{"op":"add","path":"/metadata/title","value":"Revalidate blocked items against the live state of their GitHub blockers"},{"op":"add","path":"/metadata/description","value":"Add `pm github blockers`: re-read every blocked item (plus non-terminal items whose blocked_by dependency targets an external GitHub reference), parse blocked_reason/description/comments for GitHub references (owner/repo#N, bare #N vs the item repo or --repo, full issue/PR URLs, GH-N), query their current state via batched GraphQL, and report a verdict (cleared / partially_cleared / still_blocked / unresolvable). Report-only: never auto-unblock; --comment appends one idempotent pm comment per cleared item. Exit 0 when nothing cleared, a documented non-zero code when something cleared so CI and the scheduled sync can alert."},{"op":"add","path":"/metadata/type","value":"Feature"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":2},{"op":"add","path":"/metadata/tags","value":[]},{"op":"add","path":"/metadata/created_at","value":"2026-10-12T10:46:45.720Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-12T10:46:45.720Z"},{"op":"add","path":"/metadata/author","value":"pi-gh-blockers"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"7314e0356fe842030437cfbe6441c99e2d527f4f0a9569c0637dd90baea8fe40","item_hash_version":3,"message":"","event_class":"substantive","record_hash_version":1,"record_hash":"dd30cdd5d47d48b09af9e8331
{"hash_algorithm":"sha256","ts":"2026-11-17T18:49:13.076Z","author":"pi-glm","author_source":"asserted","agent_harness":"pi","agent_model":"grok-4.7","agent_model_source":"environment","agent_instance":"83561b8f60c3b3b6cded0d52","agent_provenance":{"model":{"value":"grok-4.7","source":"environment"},"effort":null,"role":null,"topic":null},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-11-17T18:49:13.076Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-11-17T18:49:13.074Z","author":"pi-glm","text":"Root cause: the importer creates new Issues with title, type, description, body, tags, author, status and message only. Strict-preset trackers set create_mode_default to strict, so the SDK requires acceptance criteria, assignee, comment, deadline, dependency, doc, estimate, file, learning, note, priority and test. One refused create rolls back the atomic import. Design: admit new imported items with createMode progressive, and when the SDK records deferrals, defer unknown deadline, assignee, acceptance criteria and estimate with an honest import reason. Never invent those values. Updates keep their current options."}]}],"before_hash":"746b3fcab44463a20ba7910a59f58d0d1baa5712265a4ed0b91d3076e2507723","after_hash":"2d8d98f51a0777dc84c47f77a5b36c9a0283aaab41b347611453deb0c2f5995e","item_hash_version":3,"event_class":"substantive","record_hash_version":1,"record_hash":"afef909ffc765b9fb2b2aad147bc4172ac1aced90f88c1b68452018cdd27c00a"}

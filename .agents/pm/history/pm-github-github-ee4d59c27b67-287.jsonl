{"hash_algorithm":"sha256","ts":"2026-11-27T11:21:45.811Z","author":"codex-agent","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.2-sol","agent_model_source":"probe","agent_instance":"4400fc26dce6d999aa811cc5","agent_provenance":{"model":{"value":"gpt-6.2-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":null,"topic":null},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/1","value":{"created_at":"2026-11-27T11:21:45.811Z","author":"codex-agent","text":"Reproduced on pm-rl main e11861f with its locked PM CLI 2026.11.24 and pinned pm-github 2026.11.25. A frozen nine-issue REST and closure snapshot produced 17, 18, then 19 native comments for item 202. Both new comment_add rows share provider comment 7140375699. The repeat appended one history row touching comments and updated_at while reporting zero item updates and unchanged. Published 2026.11.26 differs in dist only by its version literal and predates merged #288. Auditing body, lifecycle, annotations, and dependency writes independently."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-27T11:21:45.811Z"}],"before_hash":"9c32a9991e35f6e6c5cbc429d65e6f31249dae261472b3c39bbf1dd9fed0e1d0","after_hash":"ea76d482db787056c86edb0939d9627f53252b9982cc7f3a0e9b43f6bbb25314","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"172fec7391ab53c38a47fd805e7025cfd8eab33b8b3b51615e14989b38960261"}
{"hash_algorithm":"sha256","ts":"2026-11-27T11:33:28.529Z","author":"codex-agent","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.2-sol","agent_model_source":"probe","agent_instance":"4400fc26dce6d999aa811cc5","agent_provenance":{"model":{"value":"gpt-6.2-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":null,"topic":null},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/2","value":{"created_at":"2026-11-27T11:33:28.528Z","author":"codex-agent","text":"Release comparison confirmed: 2026.11.25 and 2026.11.26 both append comment 7140375699 twice (history 36 → 38 → 39). Merged #288 reads full native annotation text and preserves the original provider timestamp (history 36 → 38 → 38). Existing dependency writes are byte-idempotent on the pinned SDK but their duplicate receipt used to count a link. The workflow now compares a source-only snapshot before writes and still requires both byte-diff checks and the privacy scan. Consumer adoption and independent hosted verification are tracked in issue #297."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-27T11:33:28.529Z"}],"before_hash":"ea76d482db787056c86edb0939d9627f53252b9982cc7f3a0e9b43f6bbb25314","after_hash":"7aeba02d27a52dd680e783f283b62019b9c9daf27b874bac2ab46ff803934f76","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"b3025f93a162d9a718c876db5b01c5b528f8af512770a5eeec4e0033e04bc146"}

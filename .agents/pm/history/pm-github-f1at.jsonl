{"hash_algorithm":"sha256","ts":"2026-10-05T06:09:58.912Z","author":"pi-glm","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"5445f482cb2cfed6ee2872fd","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-github-f1at"},{"op":"add","path":"/metadata/title","value":"Fail-closed privacy gate for automated GitHub issue imports and one reusable sync workflow"},{"op":"add","path":"/metadata/description","value":"Automated fleet-wide sync is disabled because the pilot workflow pushes imported issue text to a public branch before any privacy gate inspects the proposed tracker diff. Add a fail-closed scanner over the proposed tracker change, wire it into import as --gate, and ship one reusable workflow_call sync workflow fleet repos can call."},{"op":"add","path":"/metadata/type","value":"Feature"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":["area:ci","area:gates","area:import","area:privacy"]},{"op":"add","path":"/metadata/created_at","value":"2026-10-05T06:09:58.912Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-10-05T06:09:58.912Z"},{"op":"add","path":"/metadata/author","value":"pi-glm"},{"op":"add","path":"/metadata/acceptance_criteria","value":"A fresh checkout installs the pinned extension and exercises a nonempty issue import; malicious issue-body credential and personal-data fixtures prevent any public branch push; completeness and idempotency are checked before mutation; a clean import opens a reviewable PR with permanent PM links; existing pilot workflows and future rollouts use one audited implementation or equivalent gate."}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6d
{"hash_algorithm":"sha256","ts":"2026-11-03T01:04:50.042Z","author":"pi-ollama","author_source":"asserted","agent_harness":"pi","agent_model":"glm-5.3:cloud","agent_model_source":"environment","agent_instance":"fffd5142cf13337359aa8b1f","agent_provenance":{"model":{"value":"glm-5.3:cloud","source":"environment"},"effort":null,"role":{"value":"implementer","source":"argv"},"topic":null},"op":"create","patch":[{"op":"add","path":"/metadata/id","value":"pm-github-4gak"},{"op":"add","path":"/metadata/title","value":"Reusable workflows fail after pm package install when callers pin zero-padded release tags like v2026.11.02"},{"op":"add","path":"/metadata/description","value":"Release tags are date-shaped and zero-padded (v2026.11.02), but the daily release plan publishes npm versions without padding (2026.11.2). pm-github-sync.yml and pm-github-closeout.yml derive PM_GITHUB_VERSION from the tag on the workflow commit and compare it with the installed package.json version using strict !==, so every caller pinned to a padded tag fails the install verification. v2026.11.01 and v2026.11.02 already fail; every tag for days 1-9 of a month and every month before October would fail too. Normalize the tag version in both workflows, share the rule with the release plan, and cover it in test/self-versioned-workflows.test.ts."},{"op":"add","path":"/metadata/type","value":"Issue"},{"op":"add","path":"/metadata/status","value":"open"},{"op":"add","path":"/metadata/priority","value":1},{"op":"add","path":"/metadata/tags","value":["regression","release","workflows"]},{"op":"add","path":"/metadata/created_at","value":"2026-11-03T01:04:50.042Z"},{"op":"add","path":"/metadata/updated_at","value":"2026-11-03T01:04:50.042Z"},{"op":"add","path":"/metadata/author","value":"pi-ollama"}],"before_hash":"3cc22dff72be7b14824654a7a64ea62b04799939b2fee54c1b5f52ca60bf6df0","after_hash":"4ca55198e1212274ec0444ece240f62ce40f8b4b948b6f2fd0afd68766fa4839","item_hash_version":3,"message":"","event_class":"substantive","record_hash_version":1,"record_hash":"ea13bac0559df108fff05dc3c8d8a634aea465c61e768661b304459cfe77aeeb"}

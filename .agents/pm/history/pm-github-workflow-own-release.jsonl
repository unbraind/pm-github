{"hash_algorithm":"sha256","ts":"2026-11-14T09:12:12.957Z","author":"codex-github238-1114","author_source":"asserted","agent_harness":"codex","agent_model":"gpt-6.1-sol","agent_model_source":"probe","agent_instance":"b8a6e793d100f7f4487a97c2","agent_provenance":{"model":{"value":"gpt-6.1-sol","source":"probe"},"effort":{"value":"high","source":"probe"},"role":null,"topic":null},"op":"comment_add","patch":[{"op":"add","path":"/metadata/comments/1","value":{"created_at":"2026-11-14T09:12:12.957Z","author":"codex-github238-1114","text":"Design verified against GitHub Actions job context documentation: job.workflow_sha identifies the reusable job commit for both tag and SHA pins. Both workflows fetch their own package.json at that SHA, validate and normalize its version, honor explicit exact holds, and warn with both versions on a mismatch. Exact public registry metadata is checked before checkout/setup or tracker writes. Live transport smoke: omitted input resolved 2026.11.14; explicit 2026.10.16 remained 2026.10.16 with both versions in the warning; 2099.1.1 returned a refusal with no exported install version. Migration is in the item description and README: callers should drop pm-github-version."}},{"op":"replace","path":"/metadata/updated_at","value":"2026-11-14T09:12:12.957Z"}],"before_hash":"6f8d3a185e8753f5dd3c4946d4c9742f6a8f4bdf1dff358db3a097da8137c8ae","after_hash":"fb1de0ce4480ccd7ed1bb41b6ab24fba2af107d243eef85a4384926019bf806f","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"effort":{"status":"resolved","resolver":"codex_session_file","rule_version":"v1"},"version":{"status":"unavailable","reason":"harness_unavailable","resolver":"ai_agent_version","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"e9b089c4f3d7dfe281a05c467f0c1e4f980ba903e0f146f78112ed23b955bf56"}
